{
  "name": "iobroker.repetier-server",
  "version": "0.1.0",
  "description": "repetier-server",
  "author": {
    "name": "DutchmanNL",
    "email": "oss@DrozmotiX.eu"
  },
  "homepage": "https://github.com/DrozmotiX/ioBroker.repetier-server",
  "license": "MIT",
  "keywords": [
    "repetier",
    "repetier-server",
    "3d-printer",
    "3d-printing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DrozmotiX/ioBroker.repetier-server.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "alcalzone-shared": "^4.0.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/testing": "^5.3.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/styles": "^5.18.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "iobroker-react": "git+https://git@github.com/xXBJXx/iobroker-react#cd8fb9a1903f615b49abbc427d5646b883e5d036",
    "prettier": "^3.9.6",
    "proxyquire": "^2.1.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "source-map-support": "^0.5.21",
    "typescript": "~5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/build/",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "prebuild": "rimraf admin/build",
    "build": "build-adapter react",
    "watch": "build-adapter react --watch",
    "prebuild:react": "rimraf admin/build",
    "build:react": "build-adapter react",
    "watch:react": "build-adapter react --watch",
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "release": "release-script --all --branchPattern '*'",
    "release-dry": "release-script --all --dry"
  },
  "bugs": {
    "url": "https://github.com/DrozmotiX/ioBroker.repetier-server/issues"
  },
  "readmeFilename": "README.md"
}
